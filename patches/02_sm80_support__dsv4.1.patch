+    a_ptrs = A + offs_am_c[:, None] * K + first_tile * BLOCK_SIZE_K + offs_k[None, :]
+    b_ptrs = B + offs_bn_c[None, :] * K + first_tile * BLOCK_SIZE_K + offs_k[:, None]
+    Bs_ptrs = (
